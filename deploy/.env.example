# Production settings. On the server: /opt/trip-mapper/.env, readable by root only
# (chmod 600). Never committed.

# The site's address: a DuckDNS name pointing at this server.
DOMAIN=yourname.duckdns.org

# The image to run: CI publishes one per commit on master. Deploying is changing this.
APP_IMAGE=ghcr.io/jwei11/photo-trails:<full commit sha>

POSTGRES_USER=trips
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trips
DEFAULT_TIMEZONE=UTC

# The production bucket and an IAM user limited to it (see docs/deploy.md).
S3_REGION=us-east-2
S3_BUCKET=change-me
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Sign in with Google: the same OAuth client as development, with this site's redirect
# URI added (https://<DOMAIN>/api/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Accounts that weren't invited. "Try the demo" needs a demo loaded (docs/deploy.md);
# GUESTS_MAX caps live demo accounts. SIGNUPS_MAX > 0 lets that many people create an
# account by signing in with Google (the OAuth app must be published, not in Testing).
GUESTS_MAX=50
SIGNUPS_MAX=0
