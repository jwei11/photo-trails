# Copy to .env and change every change-me (letters and digits only: the password is put
# into a database URL). Other settings refer to those with ${...}, so each is set once.
# .env is never committed.
POSTGRES_USER=trips
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trips
# For the API and worker run outside Docker. Inside Docker, compose.yaml builds this URL
# from the three values above, with the host `db`.
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
# Zone for photos with no location, no recorded offset, and no nearby located photo
DEFAULT_TIMEZONE=UTC
# Separate database for API tests (they wipe it); leave unset to skip them
TEST_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}_test

# Local SeaweedFS (compose service "objects"): the default storage, always used by the
# tests, and the source when copying photos to S3.
SEAWEEDFS_ACCESS_KEY=change-me
SEAWEEDFS_SECRET_KEY=change-me-too

# Object storage: the bucket the app reads and writes. By default it's the local SeaweedFS,
# so the S3 keys are the SeaweedFS ones above. S3_ENDPOINT is how the app reaches it from
# the Mac; DOCKER_S3_ENDPOINT is how the containers reach it, by service name.
S3_ENDPOINT=http://localhost:8333
DOCKER_S3_ENDPOINT=http://objects:8333
S3_REGION=us-east-1
S3_BUCKET=photos
S3_ACCESS_KEY=${SEAWEEDFS_ACCESS_KEY}
S3_SECRET_KEY=${SEAWEEDFS_SECRET_KEY}
# For Amazon S3 instead, use an IAM user limited to one bucket (see README), and set:
#   S3_ENDPOINT=  and  DOCKER_S3_ENDPOINT=   (both empty)
#   S3_REGION=<the bucket's region>  S3_BUCKET=<its name>  and that user's two keys

# Where the app is opened from (only used for a bucket the app manages itself)
APP_ORIGINS=http://localhost:5173,http://localhost:8000
# Bucket in the local SeaweedFS for API tests (they wipe it)
TEST_S3_BUCKET=photos-test

# Host ports, if the defaults are taken on your machine (e.g. by a local Postgres). If you
# change OBJECTS_PORT or API_PORT, change the URLs above that use them to match.
# DB_PORT=5432
# OBJECTS_PORT=8333
# API_PORT=8000
