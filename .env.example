POSTGRES_USER=trips
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trips
DATABASE_URL=postgresql+psycopg://trips:change-me@localhost:5432/trips
UPLOAD_DIR=uploads
# Zone for photos with no location, no recorded offset, and no nearby located photo
DEFAULT_TIMEZONE=UTC
# Separate database for API tests (they wipe it); leave unset to skip them
TEST_DATABASE_URL=postgresql+psycopg://trips:change-me@localhost:5432/trips_test
# Object storage: the bucket the app reads and writes. For Amazon S3, leave S3_ENDPOINT
# empty and use the access key of an IAM user limited to this one bucket (see README).
S3_ENDPOINT=
S3_REGION=us-east-2
S3_BUCKET=trip-mapper-dev-change-me
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-too
# Where the app is opened from (only used for a bucket the app manages itself)
APP_ORIGINS=http://localhost:5173,http://localhost:8000

# Local SeaweedFS (docker compose service "objects"): always used by the tests, and the
# source when copying photos to S3. To develop fully offline instead of on S3, set
# S3_ENDPOINT=http://localhost:8333, S3_REGION=us-east-1, S3_BUCKET=photos, and the S3
# keys to these same values.
SEAWEEDFS_ACCESS_KEY=change-me
SEAWEEDFS_SECRET_KEY=change-me-too
# Bucket in the local SeaweedFS for API tests (they wipe it)
TEST_S3_BUCKET=photos-test
