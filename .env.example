POSTGRES_USER=trips
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trips
DATABASE_URL=postgresql+psycopg://trips:change-me@localhost:5432/trips
UPLOAD_DIR=uploads
# Zone for photos with no location, no recorded offset, and no nearby located photo
DEFAULT_TIMEZONE=UTC
# Separate database for API tests (they wipe it); leave unset to skip them
TEST_DATABASE_URL=postgresql+psycopg://trips:change-me@localhost:5432/trips_test
# S3-compatible object storage. S3_ENDPOINT is how the API reaches the store;
# S3_PUBLIC_ENDPOINT is the host baked into presigned URLs handed to browsers.
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-too
S3_BUCKET=photos
TEST_S3_BUCKET=photos-test
